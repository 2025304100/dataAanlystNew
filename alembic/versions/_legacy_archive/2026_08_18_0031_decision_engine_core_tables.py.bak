def _ensure_index(op, inspector, table: str, name: str, columns, *, unique=False):
    """Create index idempotently: if index with same name exists, skip."""
    existing = {idx["name"] for idx in inspector.get_indexes(table)}
    if name in existing:
        return
    op.create_index(name, table, columns, unique=unique)


