revision = "wps_0036_036_decision_evidence_stop_loss_cols"
down_revision = "wps_0035_035_decision_evidence_legacy_fallback_flag"
branch_labels = None
depends_on = None


def _has_col(table: str, column: str) -> bool:
    insp = sa.inspect(op.get_bind())
    return any(c["name"] == column for c in insp.get_columns(table))


def _add(table: str, *col_defs):
    for col in col_defs:
        if not _has_col(table, col.name):
            op.add_column(table, col)


